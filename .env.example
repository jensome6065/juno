# Postgres (docker compose). SQLite is fine for local/unit tests.
# Never store raw PAN / CVV — only authorization_id + card-rules last4.
DATABASE_URL=postgresql+psycopg2://juno:juno@localhost:5432/juno

# Stripe Issuing (test mode)
# STRIPE_WEBHOOK_SECRET comes from: stripe listen --forward-to localhost:8000/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WalletWallet (Apple/Google Wallet pass) — https://www.walletwallet.dev
WALLETWALLET_API_KEY=
# Optional fixed pass links (seeded into /wallet/status)
WALLETWALLET_APPLE_PASS_URL=
WALLETWALLET_GOOGLE_PASS_URL=

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
